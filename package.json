{
  "name": "sift",
  "productName": "Sift",
  "version": "1.0.0",
  "description": "Offline Elasticsearch / OpenSearch workbench: queries, documents, mappings, analyzers, cluster health and A/B cluster compare",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.sift.workbench",
    "productName": "Sift",
    "files": ["index.html", "css/**", "js/**", "electron/**", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis", "portable"], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Sift", "artifactName": "Sift-Setup-${version}.exe" },
    "portable": { "artifactName": "Sift-Portable-${version}.exe" },
    "publish": null
  }
}
